# Copy into:
#   apps/api/.env          (all apps/api variables below)
#   apps/web/.env.local    (NEXT_PUBLIC_API_BASE_URL only)
# Never commit real secrets. Placeholders ending in _replace_me are intentional.
#
# DATABASE_URL matches docker-compose.yml (local/dev only):
#   user=pantry  password=pantry  db=pantry_lens  host=127.0.0.1  port=3306

# --- apps/api: core (required at API startup) ---
DATABASE_URL="mysql://pantry:pantry@127.0.0.1:3306/pantry_lens"
DEMO_USER_EMAIL=demo@pantry-lens.local
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- apps/api: Open Food Facts (User-Agent required when calling OFF) ---
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT="PantryLens/1.0 (demo@pantry-lens.local)"

# --- apps/api: Stripe Checkout (lazy; required for POST /api/billing/checkout) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel

# --- apps/api: Stripe webhooks (lazy; required for POST /api/webhooks/stripe) ---
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- apps/web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
